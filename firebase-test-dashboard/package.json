{
  "name": "neuroflex-firebase-test-dashboard",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Read-only desktop viewer for NeuroFlex Firestore test sessions",
  "main": "electron/main.cjs",
  "scripts": {
    "dev": "concurrently -k \"vite --host 127.0.0.1\" \"wait-on http://127.0.0.1:5173 && cross-env VITE_DEV_SERVER_URL=http://127.0.0.1:5173 electron .\"",
    "build": "vite build",
    "desktop": "npm run build && electron ."
  },
  "dependencies": {
    "firebase": "^11.10.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1"
  },
  "devDependencies": {
    "concurrently": "^9.1.0",
    "cross-env": "^7.0.3",
    "electron": "^45.3.2",
    "vite": "^8.3.8",
    "wait-on": "^8.0.2"
  },
  "overrides": {
    "@grpc/grpc-js": "^1.14.7"
  }
}
