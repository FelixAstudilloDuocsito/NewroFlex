{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "resumen": {
      "type": "string",
      "minLength": 1,
      "maxLength": 3000
    },
    "cambios_observados": {
      "type": "array",
      "minItems": 5,
      "maxItems": 5,
      "items": {
        "type": "object",
        "properties": {
          "metrica": {
            "type": "string",
            "enum": [
              "accuracy_percentage",
              "average_response_time_ms",
              "gaze_deviation_percentage",
              "controller_tremor_index",
              "session_duration_seconds"
            ]
          },
          "inicial": {
            "anyOf": [
              {
                "type": "number"
              },
              {
                "type": "null"
              }
            ]
          },
          "final": {
            "anyOf": [
              {
                "type": "number"
              },
              {
                "type": "null"
              }
            ]
          },
          "valor": {
            "anyOf": [
              {
                "type": "number"
              },
              {
                "type": "null"
              }
            ]
          },
          "unidad": {
            "type": "string",
            "enum": [
              "%",
              "puntos_porcentuales",
              "indice"
            ]
          }
        },
        "required": [
          "metrica",
          "inicial",
          "final",
          "valor",
          "unidad"
        ],
        "additionalProperties": false
      }
    },
    "advertencias": {
      "type": "array",
      "minItems": 1,
      "maxItems": 5,
      "items": {
        "type": "string",
        "enum": [
          "sesion_unica",
          "dificultad_variable",
          "datos_faltantes",
          "base_cero",
          "sin_inferencia_clinica"
        ]
      }
    }
  },
  "required": [
    "resumen",
    "cambios_observados",
    "advertencias"
  ],
  "additionalProperties": false
}
